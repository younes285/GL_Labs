{
  "openapi": "3.1.0",
  "info": {
    "title": "Library Management API",
    "description": "Catalogue, members, borrowing and reservations",
    "version": "lab-4"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Default development port; override when running locally"
    }
  ],
  "tags": [
    {
      "name": "Books",
      "description": "Manage the library catalogue"
    },
    {
      "name": "Borrowings",
      "description": "Borrow books, return them and view active loans"
    },
    {
      "name": "Reservations",
      "description": "Reserve unavailable books and cancel recorded requests"
    },
    {
      "name": "Members",
      "description": "Register and view library members"
    }
  ],
  "paths": {
    "/borrowings/{id}/return": {
      "put": {
        "tags": [
          "Borrowings"
        ],
        "summary": "Return a loan and calculate its overdue fine",
        "operationId": "returnBook",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Return a loan and calculate its overdue fine - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BorrowingDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get a book by ID",
        "operationId": "getById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get a book by ID - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Replace a book's catalogue data",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Replace a book's catalogue data - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete an unreferenced book",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Delete an unreferenced book - successful response"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/reservations": {
      "post": {
        "tags": [
          "Reservations"
        ],
        "summary": "Reserve an unavailable book for an active member",
        "operationId": "reserve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Reserve an unavailable book for an active member - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/members": {
      "get": {
        "tags": [
          "Members"
        ],
        "summary": "List all members",
        "operationId": "getAll",
        "responses": {
          "200": {
            "description": "List all members - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberDTO"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": [
          "Members"
        ],
        "summary": "Register a member",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Register a member - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/borrowings": {
      "post": {
        "tags": [
          "Borrowings"
        ],
        "summary": "Borrow an available book for 14 days",
        "operationId": "borrow",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BorrowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Borrow an available book for 14 days - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BorrowingDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "List all books",
        "operationId": "getAll_1",
        "responses": {
          "200": {
            "description": "List all books - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookDTO"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Create a book",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Create a book - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/members/{id}": {
      "get": {
        "tags": [
          "Members"
        ],
        "summary": "Get a member by ID",
        "operationId": "getById_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get a member by ID - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/members/{id}/reservations": {
      "get": {
        "tags": [
          "Reservations"
        ],
        "summary": "List a member's ACTIVE reservations in ID order",
        "operationId": "activeReservations",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List a member's ACTIVE reservations in ID order - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservationDTO"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/members/{id}/borrowings": {
      "get": {
        "tags": [
          "Borrowings"
        ],
        "summary": "List a member's active loans",
        "operationId": "activeBorrowings",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List a member's active loans - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BorrowingDTO"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/reservations/{id}": {
      "delete": {
        "tags": [
          "Reservations"
        ],
        "summary": "Cancel a reservation while retaining its history",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancel a reservation while retaining its history - successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationDTO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "example": "Book not found"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-11T14:00:00Z"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "example": "{\"bookId\":\"must not be null\"}"
            },
            "example": {
              "bookId": "must not be null"
            }
          }
        }
      },
      "BorrowingDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "bookId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "memberId": {
            "type": "integer",
            "format": "int64",
            "example": 2
          },
          "borrowDate": {
            "type": "string",
            "format": "date",
            "example": "2026-11-11"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-11-25"
          },
          "returnDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "example": "2026-11-26"
          },
          "fineAmount": {
            "type": "number",
            "example": 0.5
          }
        }
      },
      "BookDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "readOnly": true
          },
          "isbn": {
            "type": "string",
            "example": "9780132350884",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "example": "Clean Code",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "example": "Robert C. Martin",
            "minLength": 1
          },
          "genre": {
            "type": "string",
            "example": "Software Engineering",
            "minLength": 1
          },
          "publishedYear": {
            "type": "integer",
            "format": "int32",
            "example": 2008,
            "minimum": 1
          },
          "available": {
            "type": "boolean",
            "default": true,
            "example": true
          }
        },
        "required": [
          "author",
          "genre",
          "isbn",
          "publishedYear",
          "title"
        ]
      },
      "ReservationRequest": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "memberId": {
            "type": "integer",
            "format": "int64",
            "example": 2
          }
        },
        "required": [
          "bookId",
          "memberId"
        ]
      },
      "ReservationDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "bookId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "memberId": {
            "type": "integer",
            "format": "int64",
            "example": 2
          },
          "reservationDate": {
            "type": "string",
            "format": "date",
            "example": "2026-11-11"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CANCELLED"
            ],
            "example": "ACTIVE"
          }
        }
      },
      "MemberDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "example": "Maya Haddad",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "maya.haddad@usj.edu.lb",
            "minLength": 1
          },
          "membershipDate": {
            "type": "string",
            "format": "date",
            "description": "Defaults to today's server-local date",
            "example": "2026-09-01"
          },
          "active": {
            "type": "boolean",
            "default": true,
            "example": true
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "BorrowRequest": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "memberId": {
            "type": "integer",
            "format": "int64",
            "example": 2
          }
        },
        "required": [
          "bookId",
          "memberId"
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or field validation failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested library record does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Operation conflicts with the current library state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
